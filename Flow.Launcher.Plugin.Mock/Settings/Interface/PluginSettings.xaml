<UserControl x:Class="Flow.Launcher.Plugin.Mock.Settings.Interface.PluginSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:Flow.Launcher.Plugin.Mock.Settings.Models"
             d:DataContext="{d:DesignInstance models:SettingsViewModel}"
             d:DesignHeight="300"
             d:DesignWidth="500"
             mc:Ignorable="d">

    <Grid Margin="{StaticResource SettingPanelMargin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <TextBlock 
            Grid.Row="0" 
            Text="custom meme folders ^-^" 
            FontWeight="Bold" 
            FontSize="14" 
            Margin="0,0,0,10" />

        <ScrollViewer Grid.Row="1" Grid.Column="0" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <ListView
                x:Name="CustomMemeFoldersListView"
                Margin="0,0,0,20"
                BorderBrush="DarkGray"
                BorderThickness="1"
                HorizontalAlignment="Stretch"
                ItemsSource="{Binding Settings.CustomMemeFolders}"
                SelectedItem="{Binding Settings.SelectedCustomMemeFolder}"
                MouseDoubleClick="OnEditCustomMemeFolderClick"
                KeyDown="OnEditCustomMemeFolderKeyDown"
                Style="{StaticResource {x:Static GridView.GridViewStyleKey}}">

                <ListView.View>
                    <GridView>
                        <GridViewColumn
                            DisplayMemberBinding="{Binding Keyword}"
                            Header="Keyword" />
                        <GridViewColumn
                            DisplayMemberBinding="{Binding FolderPath}"
                            Header="Path" />
                        <GridViewColumn
                            DisplayMemberBinding="{Binding Description}"
                            Header="Description" />
                    </GridView>
                </ListView.View>
            </ListView>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Width="100" Margin="5, 0, 0, 0" Click="OnDeleteCustomMemeFolderClick" Content="Delete" />
            <Button Width="100" Margin="5, 0, 0, 0" Click="OnEditCustomMemeFolderClick" Content="Edit" />
            <Button Width="100" Margin="5, 0, 0, 0" Click="OnAddCustomMemeFolderClick" Content="Add" />
        </StackPanel>
    </Grid>
</UserControl>